# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=5050

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://contour:contour_dev_password@localhost:5433/contour?schema=public

# Comma-separated origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Contact form rate limit per IP.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MINUTES=15

# Set to 1 when running behind one reverse proxy (Nginx, a PaaS router, etc.).
TRUST_PROXY=0
